{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BroadRead",
      "Effect": "Allow",
      "Action": "data:read",
      "Resource": [
        "app/config.json",
        "app/catalog.json"
      ]
    },
    {
      "Sid": "OrdersWrite",
      "Effect": "Allow",
      "Action": [
        "orders:write"
      ],
      "Resource": [
        "orders"
      ]
    }
  ]
}
